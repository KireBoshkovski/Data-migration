# PostgreSQL
POSTGRES_DB=data_migration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mypassword

# SQL Server
MSSQL_SA_PASSWORD=yourStrong(!)Password

# Spring Boot DataSources
SPRING_DATASOURCE_POSTGRES_JDBC_URL=jdbc:postgresql://postgres:5432/data_migration
SPRING_DATASOURCE_POSTGRES_USERNAME=postgres
SPRING_DATASOURCE_POSTGRES_PASSWORD=mypassword

SPRING_DATASOURCE_SQLSERVER_JDBC_URL=jdbc:sqlserver://sqlserver:1433;databaseName=tempdb;trustServerCertificate=true
SPRING_DATASOURCE_SQLSERVER_USERNAME=sa
SPRING_DATASOURCE_SQLSERVER_PASSWORD=yourStrong(!)Password

# Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update